{
  "manifest_version": 3,
  "name": "MultiTeacherCodex",
  "version": "0.4.0",
  "description": "Automatically review every ChatGPT draft with an external frontier model and show only ChatGPT's revised final answer.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MultiTeacherCodex",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
